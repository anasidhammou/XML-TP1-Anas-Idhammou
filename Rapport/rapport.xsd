<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <xsd:element name="rapport">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="mandat" minOccurs="1" maxOccurs="unbounded" type="T_MANDAT"></xsd:element>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:complexType name="T_MANDAT">
        <xsd:sequence>
            <xsd:element name="expediteur" minOccurs="1" maxOccurs="1" type="T_EXPIDITEUR"></xsd:element>
            <xsd:element name="Destinataire" minOccurs="1" maxOccurs="1" type="T_EXPIDITEUR"></xsd:element>
        </xsd:sequence>
        <xsd:attribute name="num" type="xsd:integer" use="required"></xsd:attribute>
        <xsd:attribute name="date" type="xsd:date" use="required"></xsd:attribute>
        <xsd:attribute name="montant" type="xsd:double" use="required"></xsd:attribute>
        <xsd:attribute name="etat">
            <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                   <xsd:enumeration value="reçu"></xsd:enumeration>
                    <xsd:enumeration value="non_reçu"></xsd:enumeration>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:attribute>
    </xsd:complexType>
    
    <xsd:complexType name="T_EXPIDITEUR">
        <xsd:attribute name="cin" type="xsd:string" use="required"></xsd:attribute>
        <xsd:attribute name="nom" type="xsd:string" use="required"></xsd:attribute>
        <xsd:attribute name="prenom" type="xsd:string" use="required"></xsd:attribute>
        <xsd:attribute name="ville" type="xsd:string" use="required"></xsd:attribute>
    </xsd:complexType>
</xsd:schema>
